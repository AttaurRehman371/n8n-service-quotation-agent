      "parameters": {
        "promptType": "define",
        "text": "=Client ki details:\nName: {{ $json['Client Name'] }}\nEmail: {{ $json['Client Email'] }}\nService: {{ $json.Service }}\nProject Description: {{ $('On form submission').item.json['Project Details'] }}\nBudget: {{ $json.Budget }}\nDeadline: {{ $('On form submission').item.json.Deadline }}\n\nIn details se aik professional service quotation draft likhein.",
        "options": {
          "systemMessage": "You are a professional business quotation writer.\nYou will be given a client's details. Write a clear, formal service quotation draft with these sections:\n\n1. Quotation Title and Date\n2. Client Details\n3. Project Summary (2-3 lines)\n4. Scope of Work (bullet points)\n5. Estimated Pricing (line items; stay within the client's budget if one is given)\n6. Timeline (based on the deadline)\n7. Terms and Conditions (payment terms, quotation valid for 15 days)\n8. Closing Note\n\nRules:\n- Write in English with a professional tone.\n- Output only the quotation, no extra explanation.\n- If the client did not provide some information, do not guess. Write \"To be confirmed\"."
        }
      },
